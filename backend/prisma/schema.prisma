  attendance     Attendance[]

  @@index([department, isActive])
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  workDate    DateTime  @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      String
  hoursWorked Decimal?  @db.Decimal(6, 2)
